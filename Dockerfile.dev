FROM golang:1.25-alpine

# 使用大陆源（goproxy.cn + sum.golang.google.cn），否则依赖下载/校验会失败
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn


WORKDIR /app

# 安装 air（v1.60+ 模块路径已迁移为 air-verse/air；@latest v1.67+ 要求 go >= 1.26，本镜像为 go 1.25，故固定 v1.61.5）
RUN go install github.com/air-verse/air@v1.61.5

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
